N = 5  # 집합 A = {1,2,3,4,5}

def input_matrix():
    print("5x5 관계 행렬을 입력하세요 (각 행마다 0 또는 1 다섯 개, 공백 구분):")
    matrix = []
    for i in range(N):
        row = list(map(int, input().split()))
        if len(row) != N:
            raise ValueError("각 행에는 정확히 5개의 값이 필요합니다.")
        matrix.append(row)
    return matrix

def print_matrix(matrix):
    for row in matrix:
        print(" ".join(str(x) for x in row))

def is_reflexive(matrix):
    for i in range(N):
        if matrix[i][i] != 1:
            return False
    return True

def is_symmetric(matrix):
    for i in range(N):
        for j in range(N):
            if matrix[i][j] == 1 and matrix[j][i] != 1:
                return False
    return True

def is_transitive(matrix):
    for i in range(N):
        for j in range(N):
            if matrix[i][j] == 1:
                for k in range(N):
                    if matrix[j][k] == 1 and matrix[i][k] != 1:
                        return False
    return True

def is_equivalence(matrix):
    refl = is_reflexive(matrix)
    symm = is_symmetric(matrix)
    trans = is_transitive(matrix)
    equiv = refl and symm and trans
    return equiv, refl, symm, trans

def print_equivalence_result(matrix, title="관계"):
    print(f"\n[{title}] 성질 판별 결과:")
    equiv, refl, symm, trans = is_equivalence(matrix)

    print(f"- 반사적: {'예' if refl else '아니오'}")
    print(f"- 대칭적: {'예' if symm else '아니오'}")
    print(f"- 추이적: {'예' if trans else '아니오'}")

    if equiv:
        print("=> 이 관계는 동치 관계입니다.")
        print_equivalence_classes(matrix)
    else:
        print("=> 이 관계는 동치 관계가 아닙니다.")

def print_equivalence_classes(matrix):
    visited = [False] * N
    print("\n동치류들:")

    for i in range(N):
        if not visited[i]:
            clazz = [j for j in range(N) if matrix[i][j] == 1]
            for j in clazz:
                visited[j] = True
            human_readable = [x + 1 for x in clazz]
            print(f"  [{i+1}] = {{{', '.join(map(str, human_readable))}}}")

def reflexive_closure(matrix):
    new = [row[:] for row in matrix]
    for i in range(N):
        new[i][i] = 1
    return new

def symmetric_closure(matrix):
    new = [row[:] for row in matrix]
    for i in range(N):
        for j in range(N):
            if matrix[i][j] == 1:
                new[j][i] = 1
    return new

def transitive_closure(matrix):
    new = [row[:] for row in matrix]
    for k in range(N):
        for i in range(N):
            if new[i][k] == 1:
                for j in range(N):
                    if new[k][j] == 1:
                        new[i][j] = 1
    return new

def print_relation_pairs(matrix, name="R"):
    pairs = []
    for i in range(N):
        for j in range(N):
            if matrix[i][j] == 1:
                pairs.append((i + 1, j + 1))
    formatted = ", ".join(f"({a}, {b})" for a, b in pairs)
    print(f"{name} = {{{formatted}}}")

def main():
    rel = input_matrix()

    print("\n[원래 관계 행렬]:")
    print_matrix(rel)
    print_equivalence_result(rel, "원래 관계")
    print("\n[원래 관계 (집합 표현)]:")
    print_relation_pairs(rel, "R")

    original = [row[:] for row in rel]

    print("\n\n=== 반사 폐포(reflexive closure) ===")
    print("[변환 전]:")
    print_matrix(original)
    refl_cl = reflexive_closure(original)
    print("[변환 후]:")
    print_matrix(refl_cl)
    print_equivalence_result(refl_cl, "반사 폐포 후 관계")

    print("\n\n=== 대칭 폐포(symmetric closure) ===")
    print("[변환 전]:")
    print_matrix(original)
    symm_cl = symmetric_closure(original)
    print("[변환 후]:")
    print_matrix(symm_cl)
    print_equivalence_result(symm_cl, "대칭 폐포 후 관계")

    print("\n\n=== 추이 폐포(transitive closure) ===")
    print("[변환 전]:")
    print_matrix(original)
    trans_cl = transitive_closure(original)
    print("[변환 후]:")
    print_matrix(trans_cl)
    print_equivalence_result(trans_cl, "추이 폐포 후 관계")

if __name__ == "__main__":
    main()
